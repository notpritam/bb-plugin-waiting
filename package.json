{
  "name": "bb-plugin-waiting",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Waiting on you",
    "description": "What is ready for you, each item with its link, as a card above the composer (\"Waiting on you · 3\") and an overview on the home screen. Answer a question right there, say \"Do now\", put it off for later, move it up next, or tick it done. Agents add items with `bb waiting` or the waiting_* tools.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^3.2.4"
  },
  "description": "Waiting on you: a check-mark list of what is ready for you, each with its link, above the composer and on the home screen.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notpritam/bb-plugin-waiting.git"
  },
  "keywords": [
    "bb-plugin",
    "checklist",
    "waiting",
    "review"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "bb plugin build"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
